{
  "name": "peakstream",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:setup": "node scripts/ios-setup.js",
    "android:dev": "concurrently \"expo start --port 8081\" \"sleep 8 && adb reverse tcp:8081 tcp:8081 && expo run:android --no-bundler\""
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@mentra/bluetooth-sdk": "3.2.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.5.1",
    "concurrently": "^9.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-audio": "~0.3.0",
    "expo-build-properties": "~0.13.0",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "patch-package": "^8.0.1",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-vector-icons": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "typescript": "^5.3.0"
  }
}
